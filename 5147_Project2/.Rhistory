ui <- fluidPage(
titlePanel("Urban Adaptation of Common Parrot Species in Australia"),
fluidRow(
column(
width = 12,
uiOutput("narrative_panel")
)
),
fluidRow(
column(
width = 3,
h4("Filters"),
selectInput(
inputId = "species_filter",
label = "Choose species:",
choices = c("All", sort(unique(map_data$species))),
selected = "All"
),
sliderInput(
inputId = "month_filter",
label = "Choose month:",
min = 1,
max = 12,
value = c(1, 12),
step = 1
),
radioButtons(
inputId = "story_step",
label = "Narrative step:",
choices = c(
"Step 1: Meet the parrots",
"Step 2: Where and when?",
"Step 3: Human density",
"Step 4: Nighttime light"
),
selected = "Step 1: Meet the parrots"
),
hr(),
h4("Linked Chart"),
plotlyOutput("linked_chart", height = "320px")
),
column(
width = 9,
leafletOutput("map", height = "720px")
)
)
)
server <- function(input, output, session) {
output$narrative_panel <- renderUI({
base_style <- "background-color:#f5f5f5; padding:18px; border-radius:12px; margin-bottom:15px; border-left:6px solid #4C78A8;"
if (input$story_step == "Step 1: Meet the parrots") {
return(
div(
style = base_style,
h4("Step 1: Meet the parrots — Who are the main characters?"),
p("Australia’s cities are not only home to people. They are also shared with familiar birds, including Sulphur-crested Cockatoo, Rainbow Lorikeet, and Galah."),
p("This step introduces the three parrot species as the main characters of the story. Each species has its own colour on the map and charts, helping users recognise their different observation patterns."),
p("Start by choosing one species from the filter, or keep 'All' selected to compare the three parrots together.")
)
)
} else if (input$story_step == "Step 2: Where and when?") {
return(
div(
style = base_style,
h4("Step 2: Where and when are they observed?"),
p("After meeting the three parrots, the next question is where they are observed across Australia and whether their records change across the year."),
p("The central map shows the spatial distribution of parrot observations. The linked chart summarises seasonal patterns by month, giving background context before moving into urban factors."),
p("Use the month filter to explore seasonal changes, and use the species filter to see whether different parrots show different spatial patterns.")
)
)
} else if (input$story_step == "Step 3: Human density") {
return(
div(
style = base_style,
h4("Step 3: How do observations relate to human density?"),
p("The story now moves from where parrots are observed to what kind of human environment they are observed in. Human population density is used as one indicator of urbanisation."),
p("The linked chart compares parrot observation density with human population density. This helps explore whether these common parrots are mostly found away from people, or whether they are frequently recorded in more populated areas."),
p("Use the map and filters to connect specific places with their position in the human-density relationship.")
)
)
} else {
return(
div(
style = base_style,
h4("Step 4: What about nighttime light?"),
p("Cities are not only dense with people; they are also shaped by artificial light. In this final step, nighttime light is added as another urban factor."),
p("By combining human density and nighttime light, areas can be compared as different urban environments, such as brighter urban areas and darker urban spaces."),
p("This should be interpreted carefully: observation records show where parrots were reported, but they may also reflect where people are more likely to observe and record birds.")
)
)
}
})
filtered_map_data <- reactive({
data <- map_data %>%
filter(
month >= input$month_filter[1],
month <= input$month_filter[2]
)
if (input$species_filter != "All") {
data <- data %>% filter(species == input$species_filter)
}
data
})
output$map <- renderLeaflet({
data <- filtered_map_data()
leaflet(data) %>%
addProviderTiles(providers$CartoDB.Positron) %>%
setView(lng = 134, lat = -25, zoom = 4) %>%
addCircleMarkers(
lng = ~lon,
lat = ~lat,
radius = ~pmin(sqrt(obs_count) + 2, 18),
color = ~ifelse(
species %in% names(species_colours),
species_colours[species],
"#666666"
),
fillOpacity = 0.6,
stroke = FALSE,
popup = ~paste0(
"<b>Species:</b> ", species, "<br>",
"<b>LGA:</b> ", LGA_NAME25, "<br>",
"<b>Year:</b> ", year, "<br>",
"<b>Month:</b> ", month, "<br>",
"<b>Observation count:</b> ", obs_count, "<br>",
"<b>Human density:</b> ", round(ERP_Density, 2), "<br>",
"<b>Nightlight:</b> ", round(avg_rad, 2)
)
)
})
output$linked_chart <- renderPlotly({
if (input$story_step == "Step 1: Meet the parrots") {
p <- species_summary %>%
ggplot(aes(
x = reorder(species, total_observations),
y = total_observations,
fill = species,
text = paste0(
"Species: ", species,
"<br>Total observations: ", total_observations,
"<br>Main state: ", main_state
)
)) +
geom_col() +
coord_flip() +
scale_fill_manual(values = species_colours) +
labs(
x = NULL,
y = "Total observations",
title = "Total observations by species"
) +
theme_minimal() +
theme(legend.position = "none")
ggplotly(p, tooltip = "text")
} else if (input$story_step == "Step 2: Where and when?") {
p <- calendar_data %>%
ggplot(aes(
x = factor(month),
y = species,
fill = obs_count,
text = paste0(
"Species: ", species,
"<br>Month: ", month,
"<br>Observations: ", obs_count
)
)) +
geom_tile(color = "white") +
labs(
x = "Month",
y = NULL,
title = "Seasonal observation heatmap",
fill = "Obs."
) +
theme_minimal()
ggplotly(p, tooltip = "text")
} else {
p <- filtered_map_data() %>%
ggplot(aes(
x = ERP_Density,
y = obs_count,
color = species,
text = paste0(
"Species: ", species,
"<br>LGA: ", LGA_NAME25,
"<br>Human density: ", round(ERP_Density, 2),
"<br>Obs count: ", obs_count,
"<br>Nightlight: ", round(avg_rad, 2)
)
)) +
geom_point(alpha = 0.5) +
scale_x_log10() +
scale_y_log10() +
scale_color_manual(values = species_colours) +
labs(
x = "Human population density, log scale",
y = "Observation count, log scale",
title = "Parrot observations and human density"
) +
theme_minimal()
ggplotly(p, tooltip = "text")
}
})
}
shinyApp(ui, server)
runApp()
